CompileFlags:
  # Directory containing compile_commands.json (generated by CMake)
  CompilationDatabase: build

Diagnostics:
  # The build uses GCC; clangd is Clang-based, so ignore GCC-only warning flags
  Suppress:
    - "-Wunknown-warning-option"

  ClangTidy:
    Add:
      - "bugprone-*"                     # Logic bugs, suspicious memory ops, unsafe functions
      - "cert-*"                         # SEI CERT C Secure Coding rules
      - "clang-analyzer-core.*"          # NULL dereference, uninitialized values, etc.
      - "clang-analyzer-security.*"      # Insecure APIs (gets, strcpy, ...), taint, etc.
      - "clang-analyzer-unix.*"          # malloc/free misuse, leaks, double free
    Remove:
      - "bugprone-easily-swappable-parameters"   # Very noisy, low security value
